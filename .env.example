# Rivlet Admin - Supabase Environment Variables
# Copy this file to .env.local and add your real Supabase credentials

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only Service Role Secret (NEVER prefix with NEXT_PUBLIC, used for Admin user invitation API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
